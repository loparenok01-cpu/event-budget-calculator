# Шаблон необязательных переменных окружения для
# «Калькулятор бюджета события». Приложение запускается и работает
# без них — значения по умолчанию подходят для локальной работы.
#
# Скопируйте этот файл в .env и заполните нужные имена, либо задайте
# переменные в окружении операционной системы перед запуском.
#
# Имена переменных (значения не заданы намеренно):
STREAMLIT_SERVER_PORT=
STREAMLIT_SERVER_ADDRESS=
STREAMLIT_SERVER_HEADLESS=
STREAMLIT_BROWSER_GATHER_USAGE_STATS=
STREAMLIT_THEME_BASE=
